# SPDX-License-Identifier: Apache-2.0
#
# Settings for ONE environment. Copy this file to envs/<name>.env and edit it.
# One AWS account per environment: EXPECTED_ACCOUNT_ID stops every script if the profile
# points at a different account. This file holds no secrets.

# --- Required ---------------------------------------------------------------------
ENV_NAME=dev                         # lowercase, 2-15 chars; prefixes stacks and resources
AWS_PROFILE=default                  # AWS CLI profile for this environment's account.
                                     # "default" = the credentials from plain `aws configure`.
                                     # For a named profile: AWS_PROFILE=otel-dev
EXPECTED_ACCOUNT_ID=111111111111     # 12-digit account ID that profile must resolve to

# --- Optional (defaults shown) ------------------------------------------------------
# AWS_CLI=aws                        # path to the CLI if `aws` is not on PATH, e.g. /usr/local/bin/aws
# AWS_REGION=us-east-1               # only us-east-1 is supported (Lambda@Edge)
# ADMIN_EMAIL=admin@example.com      # default admin login name; never mailed, so it can be made up
# DEMO_VERSION=3.1.0                 # image tag; must match the demo code in this branch
# INSTANCE_TYPE=t4g.large            # arm64 Graviton with >= 8 GiB memory
# ROOT_VOLUME_GIB=150                # changing this later REPLACES the instance
# LOCAL_RETENTION_DAYS=60            # Jaeger, Prometheus, OpenSearch on the instance
# S3_RETENTION_DAYS=90               # raw OTLP archive in S3
# AMI_ID=ami-...                     # empty: latest AL2023 arm64 at first deploy, then kept.
                                     # Setting a new ID REPLACES the instance.

# --- Code the instance downloads (normally leave unset) -----------------------------
# deploy.sh uses this checkout's git remote and current branch. Override only to deploy
# something other than what you have checked out.
# GIT_REMOTE=origin                  # remote to read the URL from
# REPO_URL=https://github.com/<user>/opentelemetry-demo.git
# REPO_REF=aws-deploy                # branch or tag
# ALLOW_UNPUSHED=false               # true = deploy even if local commits are not pushed

# --- Network: leave VPC_ID unset to create a VPC (stack <ENV_NAME>-otel-network) -----
# VPC_CIDR=10.20.0.0/16
# To reuse a VPC instead: two private subnets in different AZs with a route to a NAT
# Gateway, and an internet gateway on the VPC (CloudFront VPC origins need one).
# VPC_ID=vpc-0123456789abcdef0
# PRIVATE_SUBNET_A=subnet-0123456789abcdef0
# PRIVATE_SUBNET_B=subnet-0fedcba9876543210
